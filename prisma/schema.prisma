// Prisma schema for Circular Coffee Hub
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "mysql"
}

// ─── Admin users ──────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique @db.VarChar(191)
  name                String?
  passwordHash        String
  role                Role                 @default(ADMIN)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(191)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// ─── Publications ─────────────────────────────────────────────────────────────

model Publication {
  id        String            @id @default(cuid())
  title     String
  authors   String
  year      Int
  type      PublicationType
  pillar    String?
  status    PublicationStatus @default(DRAFT)
  abstract  String?           @db.Text
  url       String?           @db.Text
  doi       String?
  pdfUrl    String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum PublicationType {
  JOURNAL
  POLICY_BRIEF
  MANUAL
  CONFERENCE
  REPORT
}

enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

// ─── Team members ─────────────────────────────────────────────────────────────

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  institution String
  country     String
  pillar      String?
  bio         String?  @db.Text
  email       String?
  imageUrl    String?  @db.Text
  linkedin    String?  @db.Text
  twitter     String?  @db.Text
  instagram   String?  @db.Text
  website     String?  @db.Text
  active        Boolean  @default(true)
  order         Int      @default(0)
  featured      Boolean  @default(false)
  featuredOrder Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── News & Events ────────────────────────────────────────────────────────────

model NewsEvent {
  id            String          @id @default(cuid())
  title         String
  type          NewsEventType
  date          DateTime
  status        NewsEventStatus @default(DRAFT)
  excerpt       String?         @db.Text
  content       String?         @db.Text
  location      String?         @db.Text
  imageUrl      String?         @db.Text
  tag           NewsEventTag?
  featured      Boolean         @default(false)
  featuredOrder Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum NewsEventType {
  FIELD_NEWS
  ACADEMIC_NEWS
  EVENT
}

enum NewsEventTag {
  ACADEMIC_AND_CAPACITY
  FIELDWORK_AND_SOCIETAL
  GOVERNANCE_AND_PARTNERSHIP
  ADMINISTRATIVE
  OPEN_CALLS
}

enum NewsEventStatus {
  DRAFT
  UPCOMING
  PUBLISHED
  PAST
}

// ─── Research projects ────────────────────────────────────────────────────────

model ResearchProject {
  id          String                @id @default(cuid())
  title       String
  pillar      String
  status      ResearchStatus        @default(ACTIVE)
  lead        String?
  description String?               @db.Text
  startDate   DateTime?
  endDate     DateTime?
  order       Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  members     ResearchTopicMember[]
}

model ResearchTopicMember {
  id        String          @id @default(cuid())
  name      String
  role      String?
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model PillarContent {
  id         String  @id @default(cuid())
  pillar     String  @unique
  title      String
  tagline    String  @db.Text
  laymanDesc String? @db.Text
  imageUrl   String? @db.Text
}

enum ResearchStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// ─── Contact messages ─────────────────────────────────────────────────────────

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  organisation String?
  subject      String
  body         String   @db.Text
  read         Boolean  @default(false)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ─── Newsletter subscribers ───────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(191)
  name      String?
  source    String? // "contact_form" | "sidebar_widget" | "homepage"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Partners ─────────────────────────────────────────────────────────────────

model Partner {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String?  @db.Text
  website      String?  @db.Text
  order        Int      @default(0)
  active       Boolean  @default(true)
  description  String?  @db.Text
  role         String?
  isHorizontal Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Collaborators ────────────────────────────────────────────────────────────

model Collaborator {
  id           String              @id @default(cuid())
  name         String
  role         String
  organisation String
  country      String
  category     CollaboratorCategory @default(OTHER)
  bio          String?             @db.Text
  email        String?
  imageUrl     String?             @db.Text
  linkedin     String?             @db.Text
  twitter      String?             @db.Text
  instagram    String?             @db.Text
  website      String?             @db.Text
  active       Boolean             @default(true)
  order        Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

enum CollaboratorCategory {
  GOVERNMENT
  SPONSOR
  NGO
  ACADEMIC
  INDUSTRY
  OTHER
}

// ─── Home page hero content ───────────────────────────────────────────────────

model HomeContent {
  id              String   @id @default(cuid())
  heroTitle1      String   @default("Beyond the Bean: Empowering")
  heroTitle2      String   @default("Communities Through Coffee Innovation")
  heroSubtitle    String   @default("We turn coffee waste into wealth. Our project empowers local farmers and women's cooperatives in Sidama and Yirgacheffe by creating green energy, bio-pesticides, and premium cosmetics—proving that zero-waste agriculture leads to thriving communities.") @db.Text
  impactTitle     String   @default("Delivering")
  impactTitleBold String   @default(" Circular Impact")
  stat1Value      Int      @default(3)
  stat1Suffix     String   @default("")
  stat1Label      String   @default("Research Pillars")
  stat2Value      Int      @default(2)
  stat2Suffix     String   @default("")
  stat2Label      String   @default("Countries")
  stat3Value      Int      @default(5)
  stat3Suffix     String   @default("+")
  stat3Label      String   @default("Years Impact")
  updatedAt       DateTime @updatedAt
}

// ─── Project content (goals & work packages) ─────────────────────────────────

model ProjectInfo {
  id           String   @id @default(cuid())
  heroTitle    String   @default("The Circular Coffee Project")
  heroSubtitle String   @default("A 4-year north–south cooperative research programme funded by VLIR-UOS, bringing together expertise from Belgium and Ethiopia to build a circular coffee economy.") @db.Text
  vlirTitle    String   @default("What is VLIR-UOS?")
  vlirP1       String   @db.Text
  vlirP2Title  String   @default("What is CARES?")
  vlirP2       String   @db.Text
  updatedAt    DateTime @updatedAt
}

model ProjectProblemGroup {
  id        String                 @id @default(cuid())
  title     String
  order     Int                    @default(0)
  bullets   ProjectProblemBullet[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model ProjectProblemBullet {
  id        String              @id @default(cuid())
  text      String              @db.Text
  order     Int                 @default(0)
  groupId   String
  group     ProjectProblemGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ProjectGoal {
  id        String   @id @default(cuid())
  text      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkPackage {
  id        String   @id @default(cuid())
  wpId      String
  title     String
  lead      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Impact metrics ───────────────────────────────────────────────────────────

model ImpactSection {
  id        String   @id @default(cuid())
  tag       String   @default("Socioeconomic Transformation")
  title     String   @default("Cultivating Community & Equitable Growth")
  updatedAt DateTime @updatedAt
}

model ImpactArea {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   @default("Users")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImpactMetric {
  id        String   @id @default(cuid())
  label     String
  value     String
  pillar    String?
  year      Int
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Site Contact Info ────────────────────────────────────────────────────────

model SiteContactInfo {
  id        String   @id @default(cuid())

  // Institutional emails
  generalEmail    String?
  researchEmail   String?
  mediaEmail      String?

  // Phone numbers
  primaryPhone    String?
  secondaryPhone  String?

  // Locations
  northLocation   String? @db.Text   // e.g. "Prinsstraat 13, 2000 Antwerp, Belgium"
  southLocation   String? @db.Text   // e.g. "King George VI Street, Addis Ababa, Ethiopia"

  // Social media
  linkedin    String? @db.Text
  youtube     String? @db.Text
  twitter     String? @db.Text
  facebook    String? @db.Text
  instagram   String? @db.Text
  tiktok      String? @db.Text
  website     String? @db.Text

  updatedAt DateTime @updatedAt
}
